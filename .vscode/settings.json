{
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.cStandard": "c11",
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/rt1180-led-toggle/compile_commands.json",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/**",
    "${workspaceFolder}/../mcuxpresso-sdk/mcuxsdk/**",
    "${env:MCUXPRESSO_SDK}/mcuxsdk/**"
  ],
  "C_Cpp.default.browse.path": [
    "${workspaceFolder}/**",
    "${workspaceFolder}/../mcuxpresso-sdk/mcuxsdk/**",
    "${env:MCUXPRESSO_SDK}/mcuxsdk/**"
  ],
  "python.terminal.activateEnvironment": true,
  "cmake.configureOnOpen": true,
  "jlinkMcp.probeType": "jlink",
  "jlinkMcp.jlink.device": "MIMXRT1189xxx8_M33",
  "jlinkMcp.jlink.interface": "SWD",
  "jlinkMcp.jlink.speed": 1000,
  "files.insertFinalNewline": true,
  "editor.formatOnSave": true
}
