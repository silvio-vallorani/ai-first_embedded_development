{
  "permissions": {
    "allow": [
      "Bash(but status*)",
      "Bash(but diff*)",
      "Bash(but show*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(gh run watch*)",
      "Bash(python scripts/host_tests.py*)",
      "Bash(ctest *)",
      "Bash(cmake --build *)",
      "Bash(bash scripts/build_rt1180.sh*)",
      "Bash(.venv/Scripts/python.exe scripts/rt1180_mcuboot.py build*)",
      "Bash(.venv/bin/python scripts/rt1180_mcuboot.py build*)",
      "Bash(.venv/Scripts/python.exe scripts/rt1180_logs.py selftest*)",
      "Bash(.venv/bin/python scripts/rt1180_logs.py selftest*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(but push*)",
      "Bash(but pr*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh workflow run*)",
      "Bash(.venv/Scripts/python.exe scripts/rt1180_mcuboot.py flash*)",
      "Bash(.venv/bin/python scripts/rt1180_mcuboot.py flash*)"
    ]
  },
  "enabledMcpjsonServers": ["context7"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/adr_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking ADR-guarded files"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit.py\"",
            "timeout": 240,
            "statusMessage": "Formatting and running host unit tests"
          }
        ]
      }
    ]
  }
}
