# Single style for all project C code (firmware/, platform/, tests/, examples/): Linux braces,
# i.e. functions open their brace on a new line, control statements on the same line.
BasedOnStyle: LLVM
Language: Cpp
IndentWidth: 4
ColumnLimit: 120
BreakBeforeBraces: Linux
AllowShortFunctionsOnASingleLine: None
AlignConsecutiveMacros: Consecutive
# Include order matters with SDK headers; never reorder automatically.
SortIncludes: Never
